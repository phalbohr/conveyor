{
  "name": "@phalbohr/conveyor",
  "version": "0.1.0",
  "description": "Configurable development conveyor: agents move kanban tasks from idea to merge",
  "keywords": [
    "ai-agents",
    "claude-code",
    "codex",
    "kanban",
    "github",
    "gitlab",
    "automation",
    "cli"
  ],
  "homepage": "https://github.com/phalbohr/conveyor#readme",
  "bugs": {
    "url": "https://github.com/phalbohr/conveyor/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phalbohr/conveyor.git"
  },
  "license": "MIT",
  "author": "Pavel Polukhin",
  "type": "module",
  "bin": {
    "conveyor": "dist/bin.js"
  },
  "files": [
    "dist",
    "!dist/board/fake.*",
    "!dist/harness/fake.*",
    "templates",
    "skills"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc && node -e \"require('node:fs').chmodSync('dist/bin.js', 0o755)\"",
    "dev": "tsx src/bin.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "commander": "^15.0.0",
    "ink": "^8.0.0",
    "liquidjs": "^10.30.0",
    "react": "^19.3.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
